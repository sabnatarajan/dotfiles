[gpg]
	format = ssh

[core]
  excludesFile = ~/.config/git/ignore
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[init]
  defaultBranch = main

[includeIf "gitdir:~/work/"]
  path = ~/work/.config/git/config
[safe]
	directory = *